{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "allow",
      "curl *": "deny",
      "wget *": "deny",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git stash *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git reset *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git switch *": "deny",
      "git clean *": "deny",
      "git rm *": "deny",
      "git mv *": "deny"
    }
  }
}
